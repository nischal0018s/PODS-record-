BT 1 0 0 1 0 127.7 Tm /F4 6.6 Tf 7.9 TL (ks = range\(1, 11\)) Tj T* (wcss = [KMeans\(n_clusters=k, random_state=42, n_init=10\).fit\(Xs\).inertia_ for k in ks]) Tj T* (sil = {k: silhouette_score\(Xs, KMeans\(n_clusters=k, random_state=42, n_init=10\).fit_predict\(Xs\)\)) Tj T* (       for k in range\(2, 11\)}) Tj T* (print\("k   WCSS      Drop\(%\)     Silhouette"\)) Tj T* (for i, k in enumerate\(ks\):) Tj T* (    drop = '' if i == 0 else '%.1f' % \(\(wcss[i-1] - wcss[i]\) / wcss[i-1] * 100\)) Tj T* (    s = '' if k == 1 else '%.4f' % sil[k]) Tj T* (    print\(f"{k:<3} {wcss[i]:8.2f}  {drop:>8}   {s:>8}"\)) Tj T* (print\("\\nOptimal K by elbow:", 5, "| K with highest silhouette:", max\(sil, key=sil.get\)\)) Tj T*  T* (fig, ax = plt.subplots\(1, 2, figsize=\(12, 4.5\)\)) Tj T* (ax[0].plot\(list\(ks\), wcss, 'o-'\); ax[0].axvline\(5, color='red', ls='--', label='Optimal K = 5'\)) Tj T* (ax[0].set_xlabel\('Number of clusters \(K\)'\); ax[0].set_ylabel\('WCSS \(inertia\)'\); ax[0].set_title\('Elbow Method'\); ax[0].legend\(\)) Tj T* (ax[1].plot\(list\(sil\), list\(sil.values\(\)\), 's-', color='seagreen'\); ax[1].axvline\(5, color='red', ls='--'\)) Tj T* (ax[1].set_xlabel\('Number of clusters \(K\)'\); ax[1].set_ylabel\('Silhouette score'\); ax[1].set_title\('Silhouette Score by K'\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T* ET
